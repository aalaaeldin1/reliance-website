{
  "name": "reliance-website",
  "version": "0.1.0",
  "private": true,
  "description": "Reliance — verified home rentals in Cairo and Giza",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "cron": "tsx --env-file=.env scripts/cron.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "ical.js": "2.2.1",
    "jose": "5.10.0",
    "leaflet": "1.9.4",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/node": "22.18.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "0.31.11",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.12"
  }
}